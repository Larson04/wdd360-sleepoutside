---
import Layout from "../../layouts/Layout.astro";
import { type CollectionEntry, getCollection } from "astro:content";

// map though all products to create a page for each one
export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => ({
    params: { id: product.id },
    props: product
  }));
}
type Props = CollectionEntry<"products">;

// get the product data from the props to use in the template below. The actual data is in product.data
const product = Astro.props;
const title = product.data.name;

const description = `${product.data.descriptionHtmlSimple}`;
---
<Layout {title}>
  <script src="../../js/product.ts"></script>
  
    <main class="divider">
      <section class="product-detail">
        <h3>{product.data.brand.name}</h3>

        <h2 class="divider">{product.data.nameWithoutBrand}</h2>

        <img
          class="divider"
          src={product.data.image}
          alt={product.data.name}
        />

        <h4 class="product-card__price">${product.data.finalPrice}</h4>

        {product.data.finalPrice != product.data.suggestedRetailPrice && (
          <p class="product-card__discount">
            <span class="product-card__original-price">
              ${(product.data.suggestedRetailPrice).toFixed(2)}
            </span>
              {`(${(100 - (product.data.finalPrice / product.data.suggestedRetailPrice) * 100).toFixed(0)}% off)`}
          </p>
        )}

        <!-- <p class="product-card__discount">${product.data.listPrice}</p> -->

        <p class="product__color">{product.data.colors[0].colorName}</p>

        <p class="product__description" set:html={description}></p>

        <div class="product-detail__add">
          <button id="addToCart" data-id={product.data.id}>Add to Cart</button>
        </div>
      </section>
    </main>
  
</Layout>