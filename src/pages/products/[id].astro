---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { findProductById } from "../../js/productData.mts";

// map though all products to create a page for each one
const { id } = Astro.params;

let product = null;

if (id) {
  product = await findProductById(id);
}

if (!product) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
}

let title = `Product ${id} not found`;
let description = '';
if (product != null) {
  title = product.name;
  description = `${product.descriptionHtmlSimple}`;

}



---

<Layout {title}>  
    <main class="divider">
      <section class="product-detail">
        {product == null && (
          <h3>{title}</h3>
        )}
        {product &&  (

          <h3>{product.brand.name}</h3>
          
          <h2 class="divider">{product.nameWithoutBrand}</h2>
          
          <img
          class="divider"
          src={product.images.primaryExtraLarge}
          alt={product.name}
          />
          
          <h4 class="product-card__price">${product.finalPrice}</h4>
          
        )}
        {product && product.finalPrice != product.suggestedRetailPrice && (
          <p class="product-card__discount">
          <span class="product-card__original-price">
              ${(product.suggestedRetailPrice).toFixed(2)}
          </span>
              {`(${(100 - (product.finalPrice / product.suggestedRetailPrice) * 100).toFixed(0)}% off)`}
          </p>
        )}
              
              <!-- <p class="product-card__discount">${product.data.listPrice}</p> -->
        {product && (

          <p class="product__color">{product.colors[0].colorName}</p>
          
          <p class="product__description" set:html={description}></p>
          
          <div class="product-detail__add">
              <button  id="addToCart" data-id={product.id}>Add to Cart</button>
          </div>
        )}  
      </section>
    </main>

  <script>
    import '../../js/product.ts';
  </script>
</Layout>